# Copy to ~/.config/imou-camera.env and chmod 600.
# These credentials are the camera's own account (the one you set in the
# vendor app as the device password / "safety code"), NOT your Imou account.
IMOU_HOST=192.168.1.100
IMOU_USER=admin
IMOU_PASS=change-me

# 0 = main stream (1080p), 1 = sub stream (low bandwidth)
IMOU_SUBTYPE=0

# where local recordings and snapshots go
IMOU_OUTDIR=/home/you/imou-recordings

# recorder behaviour
IMOU_SEGMENT=300
IMOU_RETAIN_DAYS=30

# optional: pin an ffmpeg build if it is not on PATH
# FFMPEG=/usr/bin/ffmpeg
